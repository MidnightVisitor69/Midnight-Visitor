static var _by_id: Dictionary = {}


static func _index() -> Dictionary:
	if _by_id.is_empty():
		for c in CARDS:
			_by_id[str(c["card_id"])] = c
	return _by_id


static func has_card(card_id: String) -> bool:
	return _index().has(card_id)


## The full metadata record for a card, or an empty Dictionary if unknown.
static func by_id(card_id: String) -> Dictionary:
	return _index().get(card_id, {})


## res://art-relative base.png path for a card, or "" if the card is not
## in the catalog. CardArt uses this to resolve art when the incoming
## art_path is empty or in a non-loadable form.
static func art_path_for(card_id: String) -> String:
	return str(by_id(card_id).get("art_path", ""))


static func all() -> Array[Dictionary]:
	return CARDS


## Distinct set ids, sorted — drives the collection's set selector.
static func set_ids() -> Array[String]:
	var seen: Array[String] = []
	for c in CARDS:
		var sid := str(c["set_id"])
		if not seen.has(sid):
			seen.append(sid)
	seen.sort()
	return seen
