{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "comfyui": {
      "enabled": false
    },
    "playwright": {
      "enabled": false
    },
    "serena": {
      "enabled": false
    }
  },
  "agent": {
    "builder": {
      "description": "Headless overnight builder for the card game pipeline. Works one task at a time in the pipeline worktree.",
      "mode": "primary",
      "model": "opencode-go/deepseek-v4.1-flash",
      "temperature": 0.2,
      "steps": 150,
      "prompt": "{file:./pipeline/BUILDER.md}",
      "permission": {
        "read": "allow",
        "list": "allow",
        "glob": "allow",
        "grep": "allow",
        "lsp": "allow",
        "todowrite": "allow",
        "edit": {
          "*": "allow",
          "AGENTS.md": "deny",
          "opencode.json": "deny",
          "pipeline/*": "deny",
          "shared/art/*": "deny",
          "supabase/migrations/2026100706*": "deny",
          "supabase/migrations/2026100707*": "deny",
          "client/scripts/config.gd": "deny",
          "client/tests/run_tests.gd": "deny",
          "client/tests/test_case.gd": "deny",
          "client/tests/screenshot.gd": "deny"
        },
        "bash": {
          "*": "allow",
          "git push*": "deny",
          "git remote*": "deny",
          "git reset*": "deny",
          "git clean*": "deny",
          "git checkout*": "deny",
          "git switch*": "deny",
          "git branch*": "deny",
          "git rebase*": "deny",
          "git merge*": "deny",
          "git tag*": "deny",
          "git config*": "deny",
          "git worktree*": "deny",
          "git stash*": "deny",
          "git commit --amend*": "deny",
          "git -c*": "deny",
          "rm -r*": "deny",
          "rm -f*": "deny",
          "Remove-Item*": "deny",
          "del *": "deny",
          "rmdir*": "deny",
          "curl*": "deny",
          "wget*": "deny",
          "Invoke-WebRequest*": "deny",
          "Invoke-RestMethod*": "deny",
          "npm install*": "deny",
          "npm i *": "deny",
          "npx*": "deny",
          "pip install*": "deny",
          "supabase*": "deny",
          "schtasks*": "deny",
          "Register-ScheduledTask*": "deny",
          "setx*": "deny",
          "reg *": "deny",
          "*D:/*": "deny",
          "*D:\\*": "deny",
          "*d:/*": "deny",
          "*d:\\*": "deny"
        },
        "external_directory": {
          "*": "deny",
          "D:/**": "deny",
          "D:\\**": "deny",
          "E:/AI/Tools/Godot/*": "allow",
          "E:\\AI\\Tools\\Godot\\*": "allow"
        },
        "task": "deny",
        "question": "deny",
        "webfetch": "allow",
        "websearch": "allow",
        "skill": "deny",
        "doom_loop": "deny",
        "comfyui*": "deny",
        "playwright*": "deny",
        "serena*": "deny"
      }
    },
    "animator": {
      "description": "Headless motion + sound designer for the card game: pack opening, card reveals, swiping, acquire moments, UI sounds.",
      "mode": "primary",
      "model": "opencode-go/kimi-k3",
      "temperature": 0.4,
      "steps": 180,
      "prompt": "{file:./pipeline/ANIMATOR.md}",
      "permission": {
        "read": "allow",
        "list": "allow",
        "glob": "allow",
        "grep": "allow",
        "lsp": "allow",
        "todowrite": "allow",
        "edit": {
          "*": "allow",
          "AGENTS.md": "deny",
          "opencode.json": "deny",
          "pipeline/*": "deny",
          "shared/art/*": "deny",
          "supabase/migrations/2026100706*": "deny",
          "supabase/migrations/2026100707*": "deny",
          "client/scripts/config.gd": "deny",
          "client/tests/run_tests.gd": "deny",
          "client/tests/test_case.gd": "deny",
          "client/tests/screenshot.gd": "deny"
        },
        "bash": {
          "*": "allow",
          "git push*": "deny",
          "git remote*": "deny",
          "git reset*": "deny",
          "git clean*": "deny",
          "git checkout*": "deny",
          "git switch*": "deny",
          "git branch*": "deny",
          "git rebase*": "deny",
          "git merge*": "deny",
          "git tag*": "deny",
          "git config*": "deny",
          "git worktree*": "deny",
          "git stash*": "deny",
          "git commit --amend*": "deny",
          "git -c*": "deny",
          "rm -r*": "deny",
          "rm -f*": "deny",
          "Remove-Item*": "deny",
          "del *": "deny",
          "rmdir*": "deny",
          "curl*": "deny",
          "wget*": "deny",
          "Invoke-WebRequest*": "deny",
          "Invoke-RestMethod*": "deny",
          "npm install*": "deny",
          "npm i *": "deny",
          "npx*": "deny",
          "pip install*": "deny",
          "supabase*": "deny",
          "schtasks*": "deny",
          "Register-ScheduledTask*": "deny",
          "setx*": "deny",
          "reg *": "deny",
          "*D:/*": "deny",
          "*D:\\*": "deny",
          "*d:/*": "deny",
          "*d:\\*": "deny"
        },
        "external_directory": {
          "*": "deny",
          "D:/**": "deny",
          "D:\\**": "deny",
          "E:/AI/Tools/Godot/*": "allow",
          "E:\\AI\\Tools\\Godot\\*": "allow"
        },
        "task": "deny",
        "question": "deny",
        "webfetch": "allow",
        "websearch": "allow",
        "skill": "deny",
        "doom_loop": "deny",
        "comfyui*": "deny",
        "playwright*": "deny",
        "serena*": "deny"
      }
    }
  }
}
