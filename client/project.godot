; Engine configuration file.
config_version=5

[application]
config/name="Waifu Card Collector"
config/version="0.1.0-alpha"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Mobile")

[autoload]
Config="*res://scripts/config.gd"
Settings="*res://scripts/settings/settings.gd"
Supabase="*res://scripts/supabase_client.gd"
GameState="*res://scripts/app/game_state.gd"
Sfx="*res://scripts/audio/sfx.gd"

[display]
window/size/viewport_width=1080
window/size/viewport_height=1920
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[gui]
theme/custom="res://theme/app_theme.tres"
theme/custom_font="res://theme/fonts/Manrope-Variable.ttf"

[rendering]
renderer/rendering_method="mobile"
; Android hardware needs etc2/astc-imported textures or the build shows blank cards.
textures/vram_compression/import_etc2_astc=true
